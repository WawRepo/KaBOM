# Copy to `.env` and fill in. Read automatically by docker compose for the
# ${...} substitutions in docker-compose.override.yml.
#
#   cp .env.example .env
#
# `.env` is gitignored — the client secret is a real credential. This file
# is committed and must never hold anything but placeholders.

# Google Cloud console -> Clients -> your "Web application" client.
KABOM_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
KABOM_GOOGLE_CLIENT_SECRET=replace-me

# Exact addresses, comma-separated. Anyone not listed is refused even after
# a successful Google login.
KABOM_ALLOWED_EMAILS=you@gmail.com
