# Optional local override: run the compose stack against Google sign-in
# instead of the built-in basic-auth login form.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   # fill in the two values below, then:
#   docker compose up --build
#
# Compose merges `docker-compose.override.yml` on top of docker-compose.yml
# automatically — no flags, no -f. The real file is gitignored: it holds a
# client secret, and committing it would flip everyone's `docker compose up`
# to Google mode, which would also break the Playwright suite (that drives
# the basic-auth login form).
#
# In the Google Cloud console, under Clients -> your Web application client,
# add this to "Authorized redirect URIs" alongside your production one:
#
#   http://localhost:8090/auth/callback
#
# Google special-cases localhost, so plain http is accepted there. The
# session cookie survives plain http because docker-compose.yml already
# sets KABOM_INSECURE_COOKIES=1 — dev only, never in a real deployment.

services:
  kabom:
    environment:
      KABOM_AUTH: google
      KABOM_GOOGLE_CLIENT_ID: 000000000000-xxxxxxxx.apps.googleusercontent.com
      KABOM_GOOGLE_CLIENT_SECRET: replace-me
      # Comma-separated, exact addresses. Never a domain match, never "any
      # Google account" — an OAuth app that accepts everyone looks
      # identical to a working one.
      KABOM_ALLOWED_EMAILS: you@gmail.com
      # docker-compose.yml already sets KABOM_BASIC_USER and
      # KABOM_BASIC_PASSWORD_HASH, and google mode keeps honouring them as a
      # service account — so `curl -u kabom-dev:...` still works against the
      # API while the browser uses Google. Set them to "" to turn that off.
